<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid px-4 py-4">
  <%- include('../partials/flash') %>

  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
      <span class="badge bg-primary text-white mb-1"><i class="bi bi-geo-alt me-1"></i><%= assignedLab %></span>
      <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-journal-arrow-up text-primary me-2"></i>Active Issued Items</h2>
      <p class="text-muted small mb-0">Track currently checked-out equipment and record physical returns in <%= assignedLab %>.</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
      <% if (issuedItems.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-box2 fs-1 text-muted"></i>
          <h5 class="mt-3 text-secondary">No Items Currently Issued</h5>
          <p class="text-muted small">All equipment in <%= assignedLab %> is returned or available in stock.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th class="ps-4">Asset Tag & Name</th>
                <th>Requester</th>
                <th>Issued Qty</th>
                <th>Issue Date</th>
                <th>Expected Return</th>
                <th>Status</th>
                <th class="text-end pe-4">Physical Return Action</th>
              </tr>
            </thead>
            <tbody>
              <% issuedItems.forEach(item => { %>
                <% const isOverdue = item.status === 'Overdue'; %>
                <tr class="<%= isOverdue ? 'table-danger-subtle' : '' %>">
                  <td class="ps-4">
                    <span class="badge bg-secondary font-monospace mb-1"><%= item.asset ? item.asset.assetTag : 'N/A' %></span>
                    <div class="fw-bold text-dark"><%= item.asset ? item.asset.name : 'Asset' %></div>
                  </td>
                  <td>
                    <div class="fw-bold"><%= item.requester ? item.requester.name : 'N/A' %></div>
                    <small class="text-muted"><%= item.requester ? item.requester.email : '' %></small>
                  </td>
                  <td><span class="badge bg-primary fs-6"><%= item.quantity %></span></td>
                  <td class="small"><%= item.issueDate ? new Date(item.issueDate).toLocaleDateString() : 'N/A' %></td>
                  <td class="small <%= isOverdue ? 'text-danger fw-bold' : '' %>">
                    <%= new Date(item.expectedReturnDate).toLocaleDateString() %>
                  </td>
                  <td>
                    <% if (isOverdue) { %>
                      <span class="badge bg-danger"><i class="bi bi-alarm me-1"></i> OVERDUE</span>
                    <% } else { %>
                      <span class="badge bg-primary"><i class="bi bi-check2-circle me-1"></i> ISSUED</span>
                    <% } %>
                  </td>
                  <td class="text-end pe-4">
                    <a href="/labincharge/return/<%= item._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                      <i class="bi bi-box-arrow-in-down me-1"></i> Record Return
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
