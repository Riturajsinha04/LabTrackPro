<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid px-4 py-4">
  <%- include('../partials/flash') %>

  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
      <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-clock-history text-primary me-2"></i>My Issue Request History</h2>
      <p class="text-muted small mb-0">Track real-time status of your lab equipment requests and return schedules.</p>
    </div>
    <div class="mt-3 mt-md-0">
      <a href="/requester/browse" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Request Equipment
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
      <% if (requests.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-journal-text fs-1 text-muted"></i>
          <h5 class="mt-3 text-secondary">No Requests Placed Yet</h5>
          <p class="text-muted small">You haven't requested any equipment yet. Browse the catalog to get started!</p>
          <a href="/requester/browse" class="btn btn-primary btn-sm rounded-pill">Browse Catalog</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th class="ps-4">Asset Tag & Name</th>
                <th>Lab Location</th>
                <th>Qty</th>
                <th>Purpose</th>
                <th>Request Date</th>
                <th>Expected Return</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% requests.forEach(item => { %>
                <tr>
                  <td class="ps-4">
                    <span class="badge bg-secondary font-monospace mb-1"><%= item.asset ? item.asset.assetTag : 'N/A' %></span>
                    <div class="fw-bold text-dark"><%= item.asset ? item.asset.name : 'Asset' %></div>
                  </td>
                  <td><i class="bi bi-geo-alt text-primary me-1"></i><%= item.asset ? item.asset.labLocation : 'N/A' %></td>
                  <td><span class="badge bg-light text-dark border fs-6"><%= item.quantity %></span></td>
                  <td>
                    <div class="text-secondary small text-wrap" style="max-width: 220px;"><%= item.purpose %></div>
                    <% if (item.status === 'Rejected' && item.rejectionRemark) { %>
                      <small class="text-danger d-block mt-1">Remark: "<%= item.rejectionRemark %>"</small>
                    <% } %>
                  </td>
                  <td class="small text-muted"><%= new Date(item.requestDate).toLocaleDateString() %></td>
                  <td class="small fw-medium">
                    <%= new Date(item.expectedReturnDate).toLocaleDateString() %>
                  </td>
                  <td>
                    <% if (item.status === 'Pending') { %>
                      <span class="badge bg-warning text-dark border border-warning"><i class="bi bi-hourglass-split me-1"></i> Pending</span>
                    <% } else if (item.status === 'Approved' || item.status === 'Issued') { %>
                      <span class="badge bg-primary"><i class="bi bi-check2-circle me-1"></i> Issued</span>
                    <% } else if (item.status === 'Returned') { %>
                      <span class="badge bg-success"><i class="bi bi-check-all me-1"></i> Returned</span>
                    <% } else if (item.status === 'Rejected') { %>
                      <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Rejected</span>
                    <% } else if (item.status === 'Overdue') { %>
                      <span class="badge bg-danger"><i class="bi bi-alarm me-1"></i> OVERDUE</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
