<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid px-4 py-4">
  <%- include('../partials/flash') %>

  <!-- Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
    <div>
      <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-grid-3x3-gap text-primary me-2"></i>Equipment & Asset Catalog</h2>
      <p class="text-muted small mb-0">Browse available lab equipment, check real-time stock levels, and place issue requests.</p>
    </div>
  </div>

  <!-- Filter & Search Bar -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-3 p-md-4">
      <form action="/requester/browse" method="GET" class="row g-3 align-items-end">
        
        <!-- Search Keyword -->
        <div class="col-md-4">
          <label for="search" class="form-label small fw-medium text-secondary">Search Equipment</label>
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control bg-light border-start-0" id="search" name="search" value="<%= queryFilters.search %>" placeholder="Name, tag, or description...">
          </div>
        </div>

        <!-- Category Filter -->
        <div class="col-md-3">
          <label for="category" class="form-label small fw-medium text-secondary">Category</label>
          <select class="form-select form-select-sm bg-light" id="category" name="category">
            <option value="">All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= queryFilters.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <!-- Lab Location Filter -->
        <div class="col-md-3">
          <label for="labLocation" class="form-label small fw-medium text-secondary">Lab Location</label>
          <select class="form-select form-select-sm bg-light" id="labLocation" name="labLocation">
            <option value="">All Lab Locations</option>
            <% labLocations.forEach(lab => { %>
              <option value="<%= lab %>" <%= queryFilters.labLocation === lab ? 'selected' : '' %>><%= lab %></option>
            <% }) %>
          </select>
        </div>

        <!-- Action Buttons -->
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 fw-bold">Filter</button>
          <a href="/requester/browse" class="btn btn-outline-secondary btn-sm rounded-pill" title="Clear Filters"><i class="bi bi-x-circle"></i></a>
        </div>
      </form>
    </div>
  </div>

  <!-- Asset Cards Grid -->
  <% if (assets.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-search fs-1 text-muted"></i>
      <h5 class="mt-3 text-secondary">No Equipment Found</h5>
      <p class="text-muted small">Try relaxing your search keywords or filter criteria.</p>
      <a href="/requester/browse" class="btn btn-outline-primary btn-sm rounded-pill">Reset Filters</a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% assets.forEach(ast => { %>
        <% const isAvailable = ast.availableQuantity > 0; %>
        <div class="col-md-6 col-lg-4 col-xl-3">
          <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover">
            <div class="card-header bg-white border-0 pt-3 px-3 pb-0 d-flex justify-content-between align-items-center">
              <span class="badge bg-secondary font-monospace"><%= ast.assetTag %></span>
              <span class="badge bg-light text-dark border"><i class="bi bi-geo-alt me-1"></i><%= ast.labLocation %></span>
            </div>
            
            <div class="card-body p-3">
              <h5 class="card-title fw-bold text-dark mb-1"><%= ast.name %></h5>
              <p class="small text-muted mb-2"><i class="bi bi-tag me-1"></i><%= ast.category %></p>
              
              <p class="card-text small text-secondary mb-3 text-truncate-2" style="min-height: 40px;">
                <%= ast.description || 'No detailed description specified.' %>
              </p>

              <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                <div>
                  <small class="text-muted d-block">Available Stock</small>
                  <span class="fw-bold fs-5 <%= isAvailable ? 'text-success' : 'text-danger' %>">
                    <%= ast.availableQuantity %> <small class="fs-6 text-muted">/ <%= ast.totalQuantity %></small>
                  </span>
                </div>

                <div>
                  <% if (isAvailable) { %>
                    <a href="/requester/request/<%= ast._id %>" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                      <i class="bi bi-send me-1"></i> Request
                    </a>
                  <% } else { %>
                    <button class="btn btn-secondary btn-sm rounded-pill px-3" disabled>Out of Stock</button>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
