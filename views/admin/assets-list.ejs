<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid px-4 py-4">
  <%- include('../partials/flash') %>

  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
      <h2 class="fw-bold mb-1 text-dark"><i class="bi bi-boxes text-primary me-2"></i>Equipment & Asset Management</h2>
      <p class="text-muted small mb-0">Create, edit, delete, and view maintenance records for all institutional lab equipment.</p>
    </div>
    <div class="mt-3 mt-md-0">
      <a href="/admin/assets/new" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add New Asset
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
      <% if (assets.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-inbox fs-1 text-muted"></i>
          <h5 class="mt-3 text-secondary">No Assets Found</h5>
          <p class="text-muted small">Get started by creating your first lab equipment asset.</p>
          <a href="/admin/assets/new" class="btn btn-primary btn-sm rounded-pill">Add Asset</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th class="ps-4">Asset Tag</th>
                <th>Equipment Name</th>
                <th>Category</th>
                <th>Lab Location</th>
                <th>Stock (Available / Total)</th>
                <th>Condition</th>
                <th class="text-end pe-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% assets.forEach(ast => { %>
                <tr>
                  <td class="ps-4">
                    <span class="badge bg-secondary font-monospace"><%= ast.assetTag %></span>
                  </td>
                  <td>
                    <div class="fw-bold text-dark"><%= ast.name %></div>
                    <% if (ast.description) { %>
                      <small class="text-muted d-block text-truncate" style="max-width: 250px;"><%= ast.description %></small>
                    <% } %>
                  </td>
                  <td><span class="badge bg-light text-dark border"><%= ast.category %></span></td>
                  <td><i class="bi bi-geo-alt text-primary me-1"></i><%= ast.labLocation %></td>
                  <td>
                    <span class="fw-bold <%= ast.availableQuantity > 0 ? 'text-success' : 'text-danger' %>">
                      <%= ast.availableQuantity %>
                    </span>
                    <span class="text-muted"> / <%= ast.totalQuantity %> units</span>
                  </td>
                  <td>
                    <% if (ast.condition === 'OK') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i> OK</span>
                    <% } else if (ast.condition === 'Damaged') { %>
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-exclamation-triangle me-1"></i> Damaged</span>
                    <% } else { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle me-1"></i> Lost</span>
                    <% } %>
                  </td>
                  <td class="text-end pe-4">
                    <div class="btn-group btn-group-sm">
                      <a href="/admin/assets/<%= ast._id %>/maintenance" class="btn btn-outline-info" title="Maintenance Logs">
                        <i class="bi bi-wrench"></i> Log
                      </a>
                      <a href="/admin/assets/<%= ast._id %>/edit" class="btn btn-outline-primary" title="Edit Asset">
                        <i class="bi bi-pencil"></i> Edit
                      </a>
                      <form action="/admin/assets/<%= ast._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this asset?');">
                        <button type="submit" class="btn btn-outline-danger" title="Delete Asset">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
